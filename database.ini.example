[Database]
driver=QMYSQL
host=127.0.0.1
port=3306
name=qtmediaplayer
user=root
password=123456
createDatabase=true
connectOptions=MYSQL_OPT_RECONNECT=1

; Configuration lookup order:
; 1. application directory/database.ini
; 2. QTMEDIAPLAYER_DB_CONFIG
; 3. user config directory/database.ini
;
; Development seed users are disabled by default. Set
; QTMEDIAPLAYER_SEED_DEV_USERS=1 only for disposable local databases.
