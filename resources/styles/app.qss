QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 14px;
    color: #f4f6fb;
    background-color: #15181f;
}

QMainWindow,
QDialog {
    background-color: #15181f;
}

QLabel {
    color: #f4f6fb;
    background: transparent;
}

QPushButton {
    min-height: 32px;
    padding: 6px 14px;
    color: #f4f6fb;
    background-color: #2f6fed;
    border: 1px solid #3b7cff;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #3d7fff;
}

QPushButton:pressed {
    background-color: #285dcc;
}

QPushButton:disabled {
    color: #8c93a3;
    background-color: #252a33;
    border-color: #343a46;
}

QPushButton[role="primary"] {
    color: #ffffff;
    background-color: #2b6cb0;
    border: none;
    font-weight: 600;
}

QPushButton[role="primary"]:hover {
    background-color: #3182ce;
}

QPushButton[role="primary"]:pressed {
    background-color: #2c5282;
}

QPushButton[role="secondary"] {
    color: #ffffff;
    background-color: #3182ce;
    border: none;
    font-weight: 600;
}

QPushButton[role="secondary"]:hover {
    background-color: #4299e1;
}

QPushButton[role="danger"] {
    color: #ffffff;
    background-color: #c53030;
    border: none;
    font-weight: 600;
}

QPushButton[role="danger"]:hover {
    background-color: #e53e3e;
}

QPushButton[role="warning"] {
    color: #ffffff;
    background-color: #dd6b20;
    border: none;
    font-weight: 600;
}

QPushButton[role="warning"]:hover {
    background-color: #ed8936;
}

QPushButton[role="audioRound"] {
    color: #ffffff;
    background-color: #2b6cb0;
    border: 2px solid #2c5282;
    border-radius: 30px;
    padding: 0;
}

QPushButton[role="audioRoundMain"] {
    color: #ffffff;
    background-color: #2b6cb0;
    border: 3px solid #3182ce;
    border-radius: 35px;
    padding: 0;
}

QPushButton[role="flatIcon"],
QPushButton[role="videoPlainIcon"] {
    background-color: transparent;
    border: none;
    padding: 0;
}

#AudioPlayerWidget,
#OnlineMusicSearchDialog {
    background-color: #202633;
    color: #edf2f7;
}

QWidget[component="audio"] QGroupBox#audioGroup {
    color: #90cdf4;
    border: 1px solid rgba(144, 205, 244, 0.28);
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: #252d3c;
}

QWidget[component="audio"] QGroupBox#audioGroup::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QWidget[component="audio"] QLabel {
    color: #edf2f7;
}

QWidget[component="audio"] QLabel#mutedLabel {
    color: #a0aec0;
    font-size: 10pt;
}

QWidget[component="audio"] QLabel#accentLabel {
    color: #90cdf4;
    font-weight: 600;
}

QWidget[component="audio"] QLabel#albumArt {
    background-color: #2d3748;
    border: 2px solid #4a5568;
    border-radius: 8px;
}

QWidget[component="audio"] QLabel#albumArt:hover {
    border-color: #63b3ed;
    background-color: #344155;
}

QWidget[component="audio"] QListWidget {
    background-color: #1a202c;
    color: #edf2f7;
    border: 1px solid #4a5568;
    border-radius: 6px;
    padding: 5px;
}

QWidget[component="audio"] QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #2d3748;
    border-radius: 4px;
}

QWidget[component="audio"] QListWidget::item:hover {
    background-color: #2d3748;
}

QWidget[component="audio"] QListWidget::item:selected {
    background-color: #2b6cb0;
    color: #ffffff;
}

QWidget[component="audio"] QLineEdit {
    background-color: #1a202c;
    color: #edf2f7;
    border: 1px solid #4a5568;
    border-radius: 6px;
    padding: 9px;
    font-size: 12pt;
}

QWidget[component="audio"] QLineEdit:focus {
    border-color: #63b3ed;
}

QToolButton[component="audioModeButton"] {
    background-color: #2d3748;
    color: #cbd5e0;
    border: 1px solid #4a5568;
    border-radius: 6px;
    padding: 7px 10px;
}

QToolButton[component="audioModeButton"]:hover {
    border-color: #63b3ed;
}

QToolButton[component="audioModeButton"]:checked {
    background-color: #2b6cb0;
    border-color: #90cdf4;
    color: #ffffff;
}

QWidget[component="audio"] QSlider::groove:horizontal {
    border: 1px solid #4a5568;
    height: 8px;
    background: #1a202c;
    border-radius: 4px;
}

QWidget[component="audio"] QSlider::handle:horizontal {
    background: #90cdf4;
    border: 2px solid #2b6cb0;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

QWidget[component="audio"] QSlider::handle:horizontal:hover {
    background: #bee3f8;
}

QWidget[component="audio"] QSlider::sub-page:horizontal {
    background: #2b6cb0;
    border-radius: 4px;
}

QWidget[component="audio"] QProgressBar {
    border: 1px solid #4a5568;
    border-radius: 5px;
    text-align: center;
    background-color: #1a202c;
    color: #ffffff;
}

QWidget[component="audio"] QProgressBar::chunk {
    background-color: #63b3ed;
    border-radius: 3px;
}

QMenu[component="audio"] {
    background-color: #252d3c;
    color: #ffffff;
    border: 1px solid #4a5568;
}

QMenu[component="audio"]::item {
    padding: 8px 25px;
}

QMenu[component="audio"]::item:selected {
    background-color: #2b6cb0;
}

QWidget#controlPannel,
QWidget[component="videoControl"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(26, 32, 44, 0.95), stop:1 rgba(45, 55, 72, 0.95));
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

QPushButton[role="videoTool"],
QPushButton[role="videoToolSearch"],
QPushButton[role="videoToolHistory"],
QPushButton[role="videoToolScreenshot"],
QPushButton[role="videoToolRecord"],
QPushButton[role="videoToolRecordActive"],
QPushButton[role="videoToolProcessing"],
QPushButton[role="videoToolLogin"],
QPushButton[role="videoToolDanmaku"],
QPushButton[role="videoToolDanmakuOff"],
QPushButton[role="videoToolAi"],
QPushButton[role="videoToolMine"] {
    border: none;
    border-radius: 28px;
    font-size: 9pt;
    font-weight: 700;
    padding: 0;
    min-height: 0;
}

QPushButton[role="videoTool"],
QPushButton[role="videoToolLogin"] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #667eea, stop:1 #5568d3);
}

QPushButton[role="videoToolSearch"] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f093fb, stop:1 #f5576c);
}

QPushButton[role="videoToolHistory"] {
    color: #2d3748;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a8edea, stop:1 #fed6e3);
}

QPushButton[role="videoToolScreenshot"] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4facfe, stop:1 #00f2fe);
}

QPushButton[role="videoToolRecord"] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fa709a, stop:1 #fee140);
}

QPushButton[role="videoToolRecordActive"] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ff6b6b, stop:1 #ee5a6f);
}

QPushButton[role="videoToolProcessing"],
QPushButton[role="videoToolDanmakuOff"] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #718096, stop:1 #4a5568);
}

QPushButton[role="videoToolDanmaku"] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #43e97b, stop:1 #38f9d7);
}

QPushButton[role="videoToolAi"] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f093fb, stop:1 #667eea);
}

QPushButton[role="videoToolAi"]:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #667eea, stop:1 #f093fb);
    border: 2px solid rgba(240,147,251,0.8);
}

QPushButton[role="videoToolMine"] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f6d365, stop:1 #fda085);
}

QPushButton[role="videoTool"]:pressed,
QPushButton[role="videoToolSearch"]:pressed,
QPushButton[role="videoToolHistory"]:pressed,
QPushButton[role="videoToolScreenshot"]:pressed,
QPushButton[role="videoToolRecord"]:pressed,
QPushButton[role="videoToolRecordActive"]:pressed,
QPushButton[role="videoToolProcessing"]:pressed,
QPushButton[role="videoToolLogin"]:pressed,
QPushButton[role="videoToolDanmaku"]:pressed,
QPushButton[role="videoToolDanmakuOff"]:pressed,
QPushButton[role="videoToolAi"]:pressed,
QPushButton[role="videoToolMine"]:pressed {
    background: #4a5568;
}

QWidget[component="videoControl"] QSlider::groove:horizontal {
    height: 5px;
    background: rgba(160, 174, 192, 0.22);
    border-radius: 2px;
}

QWidget[component="videoControl"] QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:1 #764ba2);
    border-radius: 2px;
}

QWidget[component="videoControl"] QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -7px 0;
    background: #ffffff;
    border-radius: 9px;
    border: 3px solid #667eea;
}

QWidget[component="videoControl"] QSlider::handle:horizontal:hover {
    background: #667eea;
}

QWidget[component="videoControl"] QComboBox {
    background: rgba(45, 55, 72, 0.8);
    color: #e2e8f0;
    border: 1px solid rgba(160, 174, 192, 0.3);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 10pt;
    font-weight: 500;
}

QWidget[component="videoControl"] QComboBox:hover {
    background: rgba(55, 65, 82, 0.9);
    border-color: rgba(102, 126, 234, 0.5);
}

QWidget[component="videoControl"] QComboBox::drop-down {
    border: none;
    width: 20px;
}

QWidget[component="videoControl"] QComboBox::down-arrow {
    image: none;
}

QWidget[component="videoControl"] QComboBox QAbstractItemView {
    background: #2d3748;
    color: #e2e8f0;
    border: 1px solid rgba(160, 174, 192, 0.3);
    border-radius: 8px;
    selection-background-color: #667eea;
    selection-color: #ffffff;
    padding: 4px;
}

QLabel[role="videoControlLabel"],
QLabel[role="videoUser"][state="loggedOut"] {
    color: #a0aec0;
    font-weight: 500;
    font-size: 10pt;
    font-family: "Microsoft YaHei";
}

QLabel[role="videoUser"][state="loggedIn"] {
    color: #64b5f6;
    font-weight: bold;
    font-size: 10pt;
    font-family: "Microsoft YaHei";
}

QLabel[role="videoTime"] {
    color: #e2e8f0;
    font-size: 11pt;
    font-weight: 500;
    font-family: "Consolas", "Microsoft YaHei";
}

QDialog#LoginDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1a202c, stop:0.5 #2d3748, stop:1 #1a202c);
}

QDialog#LoginDialog QLabel {
    color: #e2e8f0;
    font-size: 11pt;
}

QDialog#LoginDialog QLabel[role="title"] {
    color: #64b5f6;
    font-size: 24pt;
    font-weight: bold;
    margin-bottom: 10px;
}

QDialog#LoginDialog QLabel[role="status"] {
    color: #fc8181;
    font-size: 10pt;
    padding: 5px;
}

QDialog#LoginDialog QLabel[role="status"][state="success"] {
    color: #48bb78;
}

QDialog#LoginDialog QLabel[role="status"][state="error"] {
    color: #fc8181;
}

QDialog#LoginDialog QLineEdit {
    background-color: #2d3748;
    color: #ffffff;
    border: 2px solid #667eea;
    border-radius: 8px;
    padding: 10px 15px;
    font-size: 12pt;
    selection-background-color: #667eea;
}

QDialog#LoginDialog QLineEdit:focus {
    border-color: #7c8ff0;
    background-color: #374151;
}

QDialog#LoginDialog QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #667eea, stop:1 #5568d3);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 11pt;
    font-weight: bold;
}

QDialog#LoginDialog QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7c8ff0, stop:1 #667eea);
}

QDialog#LoginDialog QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5568d3, stop:1 #4451b8);
}

QDialog#LoginDialog QPushButton[role="primaryAlt"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f093fb, stop:1 #f5576c);
}

QDialog#LoginDialog QPushButton[role="primaryAlt"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fda4f4, stop:1 #f76b7d);
}

QDialog#LoginDialog QPushButton[role="secondary"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #718096, stop:1 #4a5568);
}

QDialog#LoginDialog QPushButton[role="secondary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a0aec0, stop:1 #718096);
}

QDialog#LoginDialog QCheckBox {
    color: #a0aec0;
    font-size: 10pt;
    spacing: 8px;
}

QDialog#LoginDialog QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #667eea;
    background-color: rgba(45, 55, 72, 0.8);
}

QDialog#LoginDialog QCheckBox::indicator:checked {
    background-color: #667eea;
}

QDialog#LoginDialog QGroupBox {
    border: 2px solid rgba(102, 126, 234, 0.3);
    border-radius: 12px;
    margin-top: 15px;
    padding-top: 20px;
    background-color: rgba(45, 55, 72, 0.3);
}

QDialog#LoginDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 5px 15px;
    color: #64b5f6;
    font-size: 14pt;
    font-weight: bold;
}

QDialog#OnlineVideoSearchDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1a1a2e, stop:1 #16213e);
}

QDialog#OnlineVideoSearchDialog QLineEdit {
    background-color: #0f3460;
    color: #fb7299;
    border: 2px solid #fb7299;
    border-radius: 10px;
    padding: 12px;
    font-size: 14pt;
    font-weight: bold;
}

QDialog#OnlineVideoSearchDialog QLineEdit:focus {
    border: 3px solid #00a1d6;
    background-color: #16213e;
}

QDialog#OnlineVideoSearchDialog QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fb7299, stop:1 #f25d8e);
    color: #ffffff;
    border: none;
    padding: 12px 25px;
    border-radius: 10px;
    font-weight: bold;
    font-size: 12pt;
}

QDialog#OnlineVideoSearchDialog QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #00a1d6, stop:1 #0087b8);
}

QDialog#OnlineVideoSearchDialog QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f25d8e, stop:1 #e84c7a);
}

QDialog#OnlineVideoSearchDialog QPushButton:disabled {
    background-color: #555555;
    color: #888888;
}

QDialog#OnlineVideoSearchDialog QPushButton[role="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #27ae60, stop:1 #229954);
    padding: 10px 30px;
}

QDialog#OnlineVideoSearchDialog QPushButton[role="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2ecc71, stop:1 #27ae60);
}

QDialog#OnlineVideoSearchDialog QPushButton[role="secondary"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3498db, stop:1 #2980b9);
    padding: 10px 30px;
}

QDialog#OnlineVideoSearchDialog QPushButton[role="secondary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5dade2, stop:1 #3498db);
}

QDialog#OnlineVideoSearchDialog QPushButton[role="neutral"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #95a5a6, stop:1 #7f8c8d);
    padding: 10px 30px;
}

QDialog#OnlineVideoSearchDialog QPushButton[role="neutral"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #bdc3c7, stop:1 #95a5a6);
}

QDialog#OnlineVideoSearchDialog QListWidget {
    background-color: #0f3460;
    color: #ffffff;
    border: 3px solid #fb7299;
    border-radius: 10px;
    padding: 8px;
    font-size: 11pt;
}

QDialog#OnlineVideoSearchDialog QListWidget::item {
    padding: 15px;
    border-bottom: 2px solid #16213e;
    border-radius: 6px;
    margin: 3px;
}

QDialog#OnlineVideoSearchDialog QListWidget::item:hover {
    background-color: #16213e;
    border: 1px solid #00a1d6;
}

QDialog#OnlineVideoSearchDialog QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #fb7299, stop:1 #00a1d6);
    color: #ffffff;
    font-weight: bold;
}

QDialog#OnlineVideoSearchDialog QLabel {
    color: #ffffff;
    font-size: 11pt;
}

QDialog#OnlineVideoSearchDialog QLabel[role="title"] {
    color: #fb7299;
    font-size: 24pt;
    font-weight: bold;
    padding: 15px;
    border-radius: 10px;
}

QDialog#OnlineVideoSearchDialog QLabel[role="status"] {
    color: #00a1d6;
    font-style: italic;
    font-size: 12pt;
    padding: 8px;
    background-color: rgba(251, 114, 153, 0.2);
    border-radius: 5px;
}

QDialog#OnlineVideoSearchDialog QLabel[role="sectionTitle"] {
    color: #fb7299;
    font-size: 13pt;
    font-weight: bold;
}

QDialog#OnlineVideoSearchDialog QProgressBar {
    border: 2px solid #fb7299;
    border-radius: 8px;
    text-align: center;
    background-color: #0f3460;
    color: #ffffff;
    font-weight: bold;
}

QDialog#OnlineVideoSearchDialog QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #fb7299, stop:0.5 #00a1d6, stop:1 #fb7299);
    border-radius: 6px;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QListWidget,
QTableWidget {
    color: #f4f6fb;
    background-color: #202530;
    border: 1px solid #3a4252;
    border-radius: 6px;
    selection-background-color: #2f6fed;
    selection-color: #ffffff;
}

QLineEdit,
QComboBox {
    min-height: 30px;
    padding: 4px 8px;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #343a46;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    background: #f0b84f;
    border-radius: 7px;
}

QProgressBar {
    color: #f4f6fb;
    background-color: #202530;
    border: 1px solid #3a4252;
    border-radius: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2f6fed;
    border-radius: 5px;
}
